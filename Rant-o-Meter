n  }\\n  .card {\\n    width: 100%;\\n    max-width: 420px;\\n    background: #1e1e22;\\n    border: 1px solid #333;\\n    border-radius: 20px;\\n    padding: 32px 28px 36px;\\n    text-align: center;\\n    box-shadow: 0 20px 50px rgba(0,0,0,0.5);\\n  }\\n  h1 {\\n    margin: 0 0 4px;\\n    font-size: 28px;\\n    letter-spacing: 0.5px;\\n  }\\n  .sub {\\n    margin: 0 0 24px;\\n    font-size: 13px;\\n    color: #999;\\n  }\\n  .count {\\n    font-size: 72px;\\n    font-weight: 800;\\n    line-height: 1;\\n    color: var(--brennan);\\n    transition: transform 0.12s ease;\\n  }\\n  .count.pop { transform: scale(1.25); }\\n  .out-of {\\n    font-size: 16px;\\n    color: #777;\\n    margin-bottom: 22px;\\n  }\\n  .meter {\\n    width: 100%;\\n    height: 26px;\\n    background: #2c2c30;\\n    border-radius: 14px;\\n    overflow: hidden;\\n    border: 1px solid #3a3a3f;\\n    margin-bottom: 8px;\\n  }\\n  .fill {\\n    height: 100%;\\n    width: 0%;\\n    border-radius: 14px 0 0 14px;\\n    background: linear-gradient(90deg, #ffb347, var(--brennan), #d33);\\n    transition: width 0.35s cubic-bezier(.4,1.4,.5,1);\\n  }\\n  .status {\\n    font-size: 14px;\\n    min-height: 20px;\\n    margin: 10px 0 24px;\\n    color: #ffb347;\\n    font-weight: 600;\\n  }\\n  button {\\n    font-family: inherit;\\n    cursor: pointer;\\n    border: none;\\n    border-radius: 12px;\\n    font-weight: 700;\\n    padding: 14px 20px;\\n    transition: transform 0.08s ease, filter 0.2s ease;\\n  }\\n  button:active { transform: translateY(2px) scale(0.98); }\\n  .rant-btn {\\n    width: 100%;\\n    font-size: 18px;\\n    background: var(--brennan);\\n    color: #fff;\\n    box-shadow: 0 6px 0 #b8431a;\\n    margin-bottom: 12px;\\n  }\\n  .rant-btn:active { box-shadow: 0 2px 0 #b8431a; }\\n  .rant-btn:disabled {\\n    background: #555;\\n    box-shadow: 0 6px 0 #333;\\n    cursor: not-allowed;\\n    filter: grayscale(0.4);\\n  }\\n  .reset-btn {\\n    background: transparent;\\n    color: #888;\\n    border: 1px solid #444;\\n    font-size: 13px;\\n    padding: 8px 16px;\\n  }\\n  .reset-btn:hover { color: #fff; border-color: #666; }\\n\u003c/style\u003e\\n\u003c/head\u003e\\n\u003cbody\u003e\\n  \u003cdiv class=\\\"card\\\"\u003e\\n    \u003ch1\u003e🔥 Rant-o-Meter\u003c/h1\u003e\\n    \u003cp class=\\\"sub\\\"\u003eClick every time the day earns it.\u003c/p\u003e\\n\\n    \u003cdiv class=\\\"count\\\" id=\\\"count\\\"\u003e0\u003c/div\u003e\\n    \u003cdiv class=\\\"out-of\\\"\u003eout of 20\u003c/div\u003e\\n\\n    \u003cdiv class=\\\"meter\\\"\u003e\u003cdiv class=\\\"fill\\\" id=\\\"fill\\\"\u003e\u003c/div\u003e\u003c/div\u003e\\n    \u003cdiv class=\\\"status\\\" id=\\\"status\\\"\u003eAll calm... for now. 😌\u003c/div\u003e\\n\\n    \u003cbutton class=\\\"rant-btn\\\" id=\\\"rantBtn\\\"\u003e😤 Log a Rant\u003c/button\u003e\\n    \u003cbutton class=\\\"reset-btn\\\" id=\\\"resetBtn\\\"\u003eReset\u003c/button\u003e\\n  \u003c/div\u003e\\n\\n\u003cscript\u003e\\n  const MAX = 20;\\n  let count = 0;\\n\\n  const countEl  = document.getElementById('count');\\n  const fillEl   = document.getElementById('fill');\\n  const statusEl = document.getElementById('status');\\n  const rantBtn  = document.getElementById('rantBtn');\\n  const resetBtn = document.getElementById('resetBtn');\\n\\n  const stages = [\\n    { at: 0,  msg: \\\"All calm... for now. 😌\\\" },\\n    { at: 1,  msg: \\\"And so it begins. ☕\\\" },\\n    { at: 4,  msg: \\\"Warming up nicely. 🌡️\\\" },\\n    { at: 8,  msg: \\\"Someone put a colon in a script, didn't they? 😑\\\" },\\n    { at: 12, msg: \\\"Steam detected. 💨\\\" },\\n    { at: 16, msg: \\\"Perimeter needs checking. 🚨\\\" },\\n    { at: 19, msg: \\\"One more and it's a full meltdown... 🌋\\\" },\\n    { at: 20, msg: \\\"MAXIMUM RANT ACHIEVED. Go get a coffee. 🏆\\\" }\\n  ];\\n\\n  function render() {\\n    countEl.textContent = count;\\n    fillEl.style.width = (count / MAX * 100) + '%';\\n\\n    let msg = stages[0].msg;\\n    for 