\\n    font-size: 16px;\\\\\\\\\\\\\\\\n    color: #777;\\\\\\\\\\\\\\\\n    margin-bottom: 22px;\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  .meter {\\\\\\\\\\\\\\\\n    width: 100%;\\\\\\\\\\\\\\\\n    height: 26px;\\\\\\\\\\\\\\\\n    background: #2c2c30;\\\\\\\\\\\\\\\\n    border-radius: 14px;\\\\\\\\\\\\\\\\n    overflow: hidden;\\\\\\\\\\\\\\\\n    border: 1px solid #3a3a3f;\\\\\\\\\\\\\\\\n    margin-bottom: 8px;\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  .fill {\\\\\\\\\\\\\\\\n    height: 100%;\\\\\\\\\\\\\\\\n    width: 0%;\\\\\\\\\\\\\\\\n    border-radius: 14px 0 0 14px;\\\\\\\\\\\\\\\\n    background: linear-gradient(90deg, #ffb347, var(--brennan), #d33);\\\\\\\\\\\\\\\\n    transition: width 0.35s cubic-bezier(.4,1.4,.5,1);\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  .status {\\\\\\\\\\\\\\\\n    font-size: 14px;\\\\\\\\\\\\\\\\n    min-height: 20px;\\\\\\\\\\\\\\\\n    margin: 10px 0 24px;\\\\\\\\\\\\\\\\n    color: #ffb347;\\\\\\\\\\\\\\\\n    font-weight: 600;\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  button {\\\\\\\\\\\\\\\\n    font-family: inherit;\\\\\\\\\\\\\\\\n    cursor: pointer;\\\\\\\\\\\\\\\\n    border: none;\\\\\\\\\\\\\\\\n    border-radius: 12px;\\\\\\\\\\\\\\\\n    font-weight: 700;\\\\\\\\\\\\\\\\n    padding: 14px 20px;\\\\\\\\\\\\\\\\n    transition: transform 0.08s ease, filter 0.2s ease;\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  button:active { transform: translateY(2px) scale(0.98); }\\\\\\\\\\\\\\\\n  .rant-btn {\\\\\\\\\\\\\\\\n    width: 100%;\\\\\\\\\\\\\\\\n    font-size: 18px;\\\\\\\\\\\\\\\\n    background: var(--brennan);\\\\\\\\\\\\\\\\n    color: #fff;\\\\\\\\\\\\\\\\n    box-shadow: 0 6px 0 #b8431a;\\\\\\\\\\\\\\\\n    margin-bottom: 12px;\\\\\\\\\\\\\\\\n  }\\\\\\\\\\\\\\\\n  .rant-btn:active { box-shadow: 0 2px 0 #b8431a; }\\\\\\\\\\\\\\\\n  .rant-btn:disabled {\\\\\\\\\\\\\\\\n    background: #555;\\\\\\\\\\\\\\\\n    box-shadow: 0 6px 0 #333;\\\\\\\\\\\\\\\\n    cursor: not-allowed;\\\\\\\\\\\\\\\\n    filter: grayscale(0.4);\\\\\\\\\\\